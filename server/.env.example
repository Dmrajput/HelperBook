PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/helperbook

CLIENT_URL=http://localhost:8081

OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_IP_REQUESTS_PER_HOUR=40
OTP_VERIFY_MAX_PER_WINDOW=40
REFRESH_MAX_PER_WINDOW=60

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_random_secret_at_least_32_chars
OTP_HASH_SECRET=replace_with_a_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Server-side only. Used when OTP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# local is for development only. Use cloudinary in production.
IMAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
