{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!assets/).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin|assets/|play-privacy).*)",
      "destination": "/index.html"
    }
  ]
}
